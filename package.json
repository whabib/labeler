{
	"name": "labeler",
	"type": "module",
	"description": "A lightweight alternative to Ozone for operating an atproto labeler.",
	"version": "1.0.1",
	"packageManager": "pnpm@11.18.0",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": "dist/bin.js",
	"license": "MPL-2.0",
	"repository": "https://github.com/whabib/labeler",
	"homepage": "https://github.com/whabib/labeler#readme",
	"keywords": [
		"bluesky",
		"labeler",
		"atproto"
	],
	"scripts": {
		"build": "tsc",
		"prepare": "tsc",
		"lint": "eslint .",
		"fmt": "dprint fmt",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "pnpm lint && pnpm fmt && pnpm build"
	},
	"exports": {
		".": "./dist/index.js",
		"./scripts": "./dist/scripts/index.js"
	},
	"devDependencies": {
		"@types/node": "^22.20.4",
		"@types/pg": "^8.23.1",
		"@types/prompts": "^2.4.9",
		"@types/ws": "^8.5.12",
		"dprint": "^0.41.0",
		"eslint": "^10.11.0",
		"typescript": "^5.5.4",
		"typescript-eslint": "^8.70.1",
		"vitest": "^5.0.0",
		"ws": "^8.21.3"
	},
	"dependencies": {
		"@atcute/atproto": "^3.1.8",
		"@atcute/bluesky": "^3.2.8",
		"@atcute/cbor": "^1.0.2",
		"@atcute/client": "^4.0.5",
		"@atcute/identity": "^1.1.1",
		"@atcute/identity-resolver": "^1.1.4",
		"@atcute/lexicons": "^1.2.2",
		"@atcute/ozone": "^3.1.10",
		"@atcute/xrpc-server": "^0.1.2",
		"@fastify/websocket": "^11.3.0",
		"@libsql/client": "^0.14.0",
		"@noble/curves": "^1.6.0",
		"@noble/hashes": "^1.5.0",
		"fastify": "^5.12.1",
		"pg": "^8.23.0",
		"prompts": "^2.4.2",
		"uint8arrays": "^5.1.0"
	},
	"files": [
		"dist"
	]
}
